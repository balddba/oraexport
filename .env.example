# Dedicated metadata schema; URL-encode special characters in passwords.
METADATA_URL=oracle://oraexport_meta:change_me@oracle-host:1521/?service_name=APPMETA
# Generate: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=replace_with_generated_fernet_key
# Comma-separated external browser origins, as seen through the TLS reverse proxy.
ALLOWED_ORIGIN=https://exports.example.com,https://oraexport.aaronslab.net
# Host port for the frontend in Docker Compose.
FRONTEND_PORT=8080
COOKIE_SECURE=true
GLOBAL_CONCURRENCY=2
TARGET_CONCURRENCY=1
POLL_SECONDS=5

# Metadata session bounds per API/worker process; timeouts are milliseconds.
METADATA_POOL_MAX=10
METADATA_POOL_WAIT_MS=5000
METADATA_CALL_TIMEOUT_MS=20000
